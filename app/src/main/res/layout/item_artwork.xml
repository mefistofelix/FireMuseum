<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="8dp" android:orientation="vertical" android:padding="8dp"
    android:focusable="true" android:focusableInTouchMode="true" android:background="@drawable/card_bg">
    <FrameLayout android:layout_width="match_parent" android:layout_height="150dp">
        <ImageView android:id="@+id/thumb" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:background="#FF000000"/>
        <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="6dp" android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/panel_bg"
            android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/flags" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:layout_margin="6dp" android:paddingStart="6dp" android:paddingEnd="6dp"
            android:background="@drawable/panel_bg" android:textSize="13sp"/>
    </FrameLayout>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end" android:textSize="15sp"
        android:textStyle="bold" android:textColor="@color/text"/>
    <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textColor="@color/text_dim"/>
</LinearLayout>
