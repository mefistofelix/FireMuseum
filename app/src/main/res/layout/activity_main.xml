<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="28dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="FireMuseum" android:textSize="30sp" android:textStyle="bold"
            android:textColor="@color/accent" android:layout_marginEnd="24dp"/>
        <EditText android:id="@+id/search" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:hint="@string/search_hint" android:singleLine="true"
            android:imeOptions="actionSearch" android:inputType="text" android:paddingStart="16dp"
            android:textColor="@color/text" android:textColorHint="@color/text_dim"
            android:background="@drawable/chip_bg" android:textSize="18sp"/>
        <TextView android:id="@+id/storage" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:textColor="@color/text_dim" android:textSize="14sp"/>
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/chips" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal"/>
    </HorizontalScrollView>

    <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textColor="@color/text_dim" android:textSize="14sp"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:clipToPadding="false" android:padding="6dp"/>
</LinearLayout>
